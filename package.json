{
  "name": "inkwell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode phone",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "standin:setup": "node tools/setup-standin.mjs",
    "check:fast": "tsc -p tsconfig.json && vitest run tests/unit",
