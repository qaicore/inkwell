    "golden:accept": "node scripts/golden-accept.mjs",
    "probe": "node scripts/live/probe.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.62.1",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@meta-sam/parser": "^0.1.0",
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "openai": "^7.45.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
